# Local docker compose defaults (SQL password + Azurite)
SQL_AUTH=sql
SQL_DIALECT=pymssql
SQL_HOST=127.0.0.1
SQL_PORT=14333
SQL_DATABASE=CompareTest
SQL_USERNAME=sa
SQL_PASSWORD=SqlParquet_1
SQL_ENCRYPT=no

STORAGE_AUTH=connection_string
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=parquet

# --- Azure CLI (az login) against real SQL + storage ---
# 1. az login
# 2. az account set --subscription <name-or-id>
# 3. pip install -e ".[odbc]"   # ODBC Driver 18 required for SQL
# 4. Uncomment and fill:
#
# SQL_AUTH=azure_cli
# SQL_DIALECT=pyodbc
# SQL_HOST=<server>.database.windows.net
# SQL_PORT=1433
# SQL_DATABASE=<database>
# SQL_ENCRYPT=yes
# SQL_TRUST_SERVER_CERTIFICATE=no
# SQL_USERNAME=
# SQL_PASSWORD=
#
# STORAGE_AUTH=azure_cli
# AZURE_STORAGE_ACCOUNT=<account>
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=parquet
# AZURE_TENANT_ID=
