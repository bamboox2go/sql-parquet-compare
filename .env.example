# SQL Server (docker compose defaults)
SQL_DIALECT=pymssql
SQL_HOST=127.0.0.1
SQL_PORT=14333
SQL_DATABASE=CompareTest
SQL_USERNAME=sa
SQL_PASSWORD=SqlParquet_1
SQL_ENCRYPT=no

# Azure Storage / Azurite
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=parquet

# Optional: Azure AD against a real storage account (leave connection string empty)
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
